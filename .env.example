# ── VAPI ─────────────────────────────────────────────────────────────────────
# Get from: dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_private_api_key

# Filled automatically by scripts/setup_vapi.py after first run
VAPI_PHONE_NUMBER_ID=

# Public URL where VAPI can reach this server (ngrok URL during dev)
SERVER_BASE_URL=https://abc123.ngrok.io

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Gmail 1 — sender (your company gmail)
SMTP_USER=naseebullah700000@gmail.com
FROM_EMAIL=naseebullah700000@gmail.com
# Gmail App Password for Gmail 1 — generate at: myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_app_password

# Gmail 2 — recipient (clinic owner receives notifications here)
CLINIC_OWNER_EMAIL=khannn762@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Clinic Info ───────────────────────────────────────────────────────────────
CLINIC_NAME=Bright Smiles Dental
CLINIC_ADDRESS=1234 Main St, McLean, VA 22101
CLINIC_PHONE=+17035551234
CLINIC_HOURS_MON_FRI=8:00 AM - 6:00 PM
CLINIC_HOURS_SAT=9:00 AM - 2:00 PM
CLINIC_HOURS_SUN=Closed
